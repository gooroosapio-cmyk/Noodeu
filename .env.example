# Copier ce fichier en .env.local puis renseigner les valeurs.
# Ces deux valeurs sont publiques par conception (elles sont visibles dans le navigateur) ;
# la sécurité repose sur les politiques d'accès de la base. Ne JAMAIS mettre ici la clé
# « secret » ou « service_role » de Supabase.
VITE_SUPABASE_URL=https://VOTRE-PROJET.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Afficher le bouton « Continuer avec Google » (true une fois le fournisseur configuré dans Supabase).
VITE_AUTH_GOOGLE=false
# Adresse publique affichée pour « mot de passe oublié » (facultatif ; sans elle, message de contact générique).
VITE_SUPPORT_EMAIL=
