{"ok": true, "game": {"rules": {"how_to": ["Chacun répond seul, à son rythme, dans l'ordre de la source.", "Tu peux passer une question : elle reste sans réponse (jamais comptée comme zéro).", "Le calcul est fait sur le serveur quand toutes les réponses sont données ; sinon, pas de résultat.", "Tu décides ensuite de partager ton résultat ou de le garder pour toi."], "details": ["Décrivez-vous tel que vous êtes généralement aujourd’hui, et non tel que vous souhaiteriez devenir. La consigne source propose une comparaison avec des personnes connues de même sexe et d’âge voisin.", "Période : Disposition habituelle actuelle", "Source : Lewis R. Goldberg / International Personality Item Pool — 50-item IPIP Big-Five Factor Markers.", "Résultat individuel, par dimension : ni diagnostic, ni comparaison, ni compatibilité.", "Traduction française de travail, non validée.", "Phase de test : Domaine public IPIP, copie et traduction pour tout usage autorisées par le site officiel."], "privacy": "Tes réponses détaillées restent privées. Seul ton résultat peut être partagé, si tu le décides, et tu peux retirer ce partage.", "objective": "Les cinq grands traits de personnalité", "step_texts": {}}, "title": "Les cinq grands traits de personnalité", "config": {"bank": "q_ipip", "test": {"axes": {"conscience": "Conscienciosité", "agreabilite": "Agréabilité", "extraversion": "Extraversion", "intellect_imagination": "Intellect / imagination", "stabilite_emotionnelle": "Stabilité émotionnelle"}, "code": "012", "count": 50, "input": "scale", "scales": {"IPIP5": [{"value": 1, "label_fr": "Très inexact"}, {"value": 2, "label_fr": "Plutôt inexact"}, {"value": 3, "label_fr": "Ni exact ni inexact"}, {"value": 4, "label_fr": "Plutôt exact"}, {"value": 5, "label_fr": "Très exact"}]}, "outputs": [{"name": "extraversion", "operation": "sum", "positions": [1, 6, 11, 16, 21, 26, 31, 36, 41, 46], "reverse_positions": [6, 16, 26, 36, 46]}, {"name": "agreabilite", "operation": "sum", "positions": [2, 7, 12, 17, 22, 27, 32, 37, 42, 47], "reverse_positions": [2, 12, 22, 32]}, {"name": "conscience", "operation": "sum", "positions": [3, 8, 13, 18, 23, 28, 33, 38, 43, 48], "reverse_positions": [8, 18, 28, 38]}, {"name": "stabilite_emotionnelle", "operation": "sum", "positions": [4, 9, 14, 19, 24, 29, 34, 39, 44, 49], "reverse_positions": [4, 14, 24, 29, 34, 39, 44, 49]}, {"name": "intellect_imagination", "operation": "sum", "positions": [5, 10, 15, 20, 25, 30, 35, 40, 45, 50], "reverse_positions": [10, 20, 30]}], "reserves": [], "page_size": 5, "raw_range": [1, 5], "instrument": "IPIP50", "content_version": "4.0.0", "editorial_release": "5.0.0"}, "turn": "simultaneous", "score": "none", "engine": "board", "rounds": 1, "mechanic": "test_form"}, "mechanic": "test_form", "thumbnail": "/assets/c14/012.webp", "adult_available": false}, "rounds": [{"card": {"axes": {"conscience": "Conscienciosité", "agreabilite": "Agréabilité", "extraversion": "Extraversion", "intellect_imagination": "Intellect / imagination", "stabilite_emotionnelle": "Stabilité émotionnelle"}, "done": false, "mech": "test_form", "count": 50, "input": "scale", "items": [{"id": "IPIP50-MARKERS-FR03-01", "kind": "statement", "note": null, "text": "Je suis l’âme de la fête.", "scale": "IPIP5", "position": 1, "response": "ordered_scale"}, {"id": "IPIP50-MARKERS-FR03-02", "kind": "statement", "note": null, "text": "Je me soucie peu des autres.", "scale": "IPIP5", "position": 2, "response": "ordered_scale"}, {"id": "IPIP50-MARKERS-FR03-03", "kind": "statement", "note": null, "text": "Je suis toujours prêt ou prête.", "scale": "IPIP5", "position": 3, "response": "ordered_scale"}, {"id": "IPIP50-MARKERS-FR03-04", "kind": "statement", "note": null, "text": "Je stresse facilement.", "scale": "IPIP5", "position": 4, "response": "ordered_scale"}, {"id": "IPIP50-MARKERS-FR03-05", "kind": "statement", "note": null, "text": "J’ai un vocabulaire riche.", "scale": "IPIP5", "position": 5, "response": "ordered_scale"}, {"id": "IPIP50-MARKERS-FR03-06", "kind": "statement", "note": null, "text": "Je ne parle pas beaucoup.", "scale": "IPIP5", "position": 6, "response": "ordered_scale"}, {"id": "IPIP50-MARKERS-FR03-07", "kind": "statement", "note": null, "text": "Je m’intéresse aux gens.", "scale": "IPIP5", "position": 7, "response": "ordered_scale"}, {"id": "IPIP50-MARKERS-FR03-08", "kind": "statement", "note": null, "text": "Je laisse traîner mes affaires.", "scale": "IPIP5", "position": 8, "response": "ordered_scale"}, {"id": "IPIP50-MARKERS-FR03-09", "kind": "statement", "note": null, "text": "Je suis détendu ou détendue la plupart du temps.", "scale": "IPIP5", "position": 9, "response": "ordered_scale"}, {"id": "IPIP50-MARKERS-FR03-10", "kind": "statement", "note": null, "text": "J’ai du mal à comprendre les idées abstraites.", "scale": "IPIP5", "position": 10, "response": "ordered_scale"}, {"id": "IPIP50-MARKERS-FR03-11", "kind": "statement", "note": null, "text": "Je me sens à l’aise avec les gens.", "scale": "IPIP5", "position": 11, "response": "ordered_scale"}, {"id": "IPIP50-MARKERS-FR03-12", "kind": "statement", "note": null, "text": "J’insulte les gens.", "scale": "IPIP5", "position": 12, "response": "ordered_scale"}, {"id": "IPIP50-MARKERS-FR03-13", "kind": "statement", "note": null, "text": "Je fais attention aux détails.", "scale": "IPIP5", "position": 13, "response": "ordered_scale"}, {"id": "IPIP50-MARKERS-FR03-14", "kind": "statement", "note": null, "text": "Je me fais du souci.", "scale": "IPIP5", "position": 14, "response": "ordered_scale"}, {"id": "IPIP50-MARKERS-FR03-15", "kind": "statement", "note": null, "text": "J’ai une imagination vive.", "scale": "IPIP5", "position": 15, "response": "ordered_scale"}, {"id": "IPIP50-MARKERS-FR03-16", "kind": "statement", "note": null, "text": "Je reste en retrait.", "scale": "IPIP5", "position": 16, "response": "ordered_scale"}, {"id": "IPIP50-MARKERS-FR03-17", "kind": "statement", "note": null, "text": "Je suis sensible aux sentiments des autres.", "scale": "IPIP5", "position": 17, "response": "ordered_scale"}, {"id": "IPIP50-MARKERS-FR03-18", "kind": "statement", "note": null, "text": "Je mets du désordre.", "scale": "IPIP5", "position": 18, "response": "ordered_scale"}, {"id": "IPIP50-MARKERS-FR03-19", "kind": "statement", "note": null, "text": "J’ai rarement le cafard.", "scale": "IPIP5", "position": 19, "response": "ordered_scale"}, {"id": "IPIP50-MARKERS-FR03-20", "kind": "statement", "note": null, "text": "Les idées abstraites ne m’intéressent pas.", "scale": "IPIP5", "position": 20, "response": "ordered_scale"}, {"id": "IPIP50-MARKERS-FR03-21", "kind": "statement", "note": null, "text": "J’engage la conversation.", "scale": "IPIP5", "position": 21, "response": "ordered_scale"}, {"id": "IPIP50-MARKERS-FR03-22", "kind": "statement", "note": null, "text": "Les problèmes des autres ne m’intéressent pas.", "scale": "IPIP5", "position": 22, "response": "ordered_scale"}, {"id": "IPIP50-MARKERS-FR03-23", "kind": "statement", "note": null, "text": "Je fais les tâches tout de suite.", "scale": "IPIP5", "position": 23, "response": "ordered_scale"}, {"id": "IPIP50-MARKERS-FR03-24", "kind": "statement", "note": null, "text": "Je suis facilement troublé ou troublée.", "scale": "IPIP5", "position": 24, "response": "ordered_scale"}, {"id": "IPIP50-MARKERS-FR03-25", "kind": "statement", "note": null, "text": "J’ai d’excellentes idées.", "scale": "IPIP5", "position": 25, "response": "ordered_scale"}, {"id": "IPIP50-MARKERS-FR03-26", "kind": "statement", "note": null, "text": "J’ai peu de choses à dire.", "scale": "IPIP5", "position": 26, "response": "ordered_scale"}, {"id": "IPIP50-MARKERS-FR03-27", "kind": "statement", "note": null, "text": "J’ai le cœur tendre.", "scale": "IPIP5", "position": 27, "response": "ordered_scale"}, {"id": "IPIP50-MARKERS-FR03-28", "kind": "statement", "note": null, "text": "J’oublie souvent de remettre les choses à leur place.", "scale": "IPIP5", "position": 28, "response": "ordered_scale"}, {"id": "IPIP50-MARKERS-FR03-29", "kind": "statement", "note": null, "text": "Je me contrarie facilement.", "scale": "IPIP5", "position": 29, "response": "ordered_scale"}, {"id": "IPIP50-MARKERS-FR03-30", "kind": "statement", "note": null, "text": "Je n’ai pas une bonne imagination.", "scale": "IPIP5", "position": 30, "response": "ordered_scale"}, {"id": "IPIP50-MARKERS-FR03-31", "kind": "statement", "note": null, "text": "Je parle à beaucoup de personnes différentes dans les fêtes.", "scale": "IPIP5", "position": 31, "response": "ordered_scale"}, {"id": "IPIP50-MARKERS-FR03-32", "kind": "statement", "note": null, "text": "Je ne m’intéresse pas vraiment aux autres.", "scale": "IPIP5", "position": 32, "response": "ordered_scale"}, {"id": "IPIP50-MARKERS-FR03-33", "kind": "statement", "note": null, "text": "J’aime l’ordre.", "scale": "IPIP5", "position": 33, "response": "ordered_scale"}, {"id": "IPIP50-MARKERS-FR03-34", "kind": "statement", "note": null, "text": "Mon humeur change beaucoup.", "scale": "IPIP5", "position": 34, "response": "ordered_scale"}, {"id": "IPIP50-MARKERS-FR03-35", "kind": "statement", "note": null, "text": "Je comprends vite les choses.", "scale": "IPIP5", "position": 35, "response": "ordered_scale"}, {"id": "IPIP50-MARKERS-FR03-36", "kind": "statement", "note": null, "text": "Je n’aime pas attirer l’attention sur moi.", "scale": "IPIP5", "position": 36, "response": "ordered_scale"}, {"id": "IPIP50-MARKERS-FR03-37", "kind": "statement", "note": null, "text": "Je prends du temps pour les autres.", "scale": "IPIP5", "position": 37, "response": "ordered_scale"}, {"id": "IPIP50-MARKERS-FR03-38", "kind": "statement", "note": null, "text": "Je me dérobe à mes obligations.", "scale": "IPIP5", "position": 38, "response": "ordered_scale"}, {"id": "IPIP50-MARKERS-FR03-39", "kind": "statement", "note": null, "text": "J’ai de fréquentes sautes d’humeur.", "scale": "IPIP5", "position": 39, "response": "ordered_scale"}, {"id": "IPIP50-MARKERS-FR03-40", "kind": "statement", "note": null, "text": "J’utilise des mots difficiles.", "scale": "IPIP5", "position": 40, "response": "ordered_scale"}, {"id": "IPIP50-MARKERS-FR03-41", "kind": "statement", "note": null, "text": "Cela ne me dérange pas d’être au centre de l’attention.", "scale": "IPIP5", "position": 41, "response": "ordered_scale"}, {"id": "IPIP50-MARKERS-FR03-42", "kind": "statement", "note": null, "text": "Je ressens les émotions des autres.", "scale": "IPIP5", "position": 42, "response": "ordered_scale"}, {"id": "IPIP50-MARKERS-FR03-43", "kind": "statement", "note": null, "text": "Je respecte un emploi du temps.", "scale": "IPIP5", "position": 43, "response": "ordered_scale"}, {"id": "IPIP50-MARKERS-FR03-44", "kind": "statement", "note": null, "text": "Je m’irrite facilement.", "scale": "IPIP5", "position": 44, "response": "ordered_scale"}, {"id": "IPIP50-MARKERS-FR03-45", "kind": "statement", "note": null, "text": "Je prends le temps de réfléchir aux choses.", "scale": "IPIP5", "position": 45, "response": "ordered_scale"}, {"id": "IPIP50-MARKERS-FR03-46", "kind": "statement", "note": null, "text": "Je suis réservé ou réservée avec les personnes que je ne connais pas.", "scale": "IPIP5", "position": 46, "response": "ordered_scale"}, {"id": "IPIP50-MARKERS-FR03-47", "kind": "statement", "note": null, "text": "Je mets les gens à l’aise.", "scale": "IPIP5", "position": 47, "response": "ordered_scale"}, {"id": "IPIP50-MARKERS-FR03-48", "kind": "statement", "note": null, "text": "Je suis exigeant ou exigeante dans mon travail.", "scale": "IPIP5", "position": 48, "response": "ordered_scale"}, {"id": "IPIP50-MARKERS-FR03-49", "kind": "statement", "note": null, "text": "J’ai souvent le cafard.", "scale": "IPIP5", "position": 49, "response": "ordered_scale"}, {"id": "IPIP50-MARKERS-FR03-50", "kind": "statement", "note": null, "text": "Je déborde d’idées.", "scale": "IPIP5", "position": 50, "response": "ordered_scale"}], "scales": {"IPIP5": [{"value": 1, "label_fr": "Très inexact"}, {"value": 2, "label_fr": "Plutôt inexact"}, {"value": 3, "label_fr": "Ni exact ni inexact"}, {"value": 4, "label_fr": "Plutôt exact"}, {"value": 5, "label_fr": "Très exact"}]}, "shared": {}, "declined": {}, "reserves": [], "completed": {}, "page_size": 5}, "answers": [], "private": null, "revealed": false, "round_no": 1, "solution": null, "reveal_at": null}], "my_seat": 1, "players": [{"seat": 1, "is_me": true, "ready": true, "user_id": "11111111-1111-4111-8111-111111111111", "word_form": "n", "avatar_path": null, "keep_memory": false, "display_name": "Maya"}, {"seat": 2, "is_me": false, "ready": true, "user_id": "22222222-2222-4222-8222-222222222222", "word_form": "n", "avatar_path": null, "keep_memory": false, "display_name": "Alex"}], "session": {"id": "e586e465-166b-4c0c-b899-e85c5bdea55d", "result": {}, "status": "playing", "game_id": "ND-Q-012", "ended_at": null, "settings": {}, "closed_at": null, "paused_by": null, "read_only": false, "created_at": "2026-10-24T13:56:42.739204+00:00", "started_at": "2026-10-24T13:56:42.739204+00:00", "game_version": 1, "total_rounds": 1, "current_round": 1, "state_version": 4}, "my_prefs": {"adult": false, "excluded_topics": []}}