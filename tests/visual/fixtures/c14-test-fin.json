09", "kind": "statement", "note": null, "text": "Je crains qu’elle ne tienne pas autant à moi que je tiens à elle.", "scale": "ECR7", "position": 9, "response": "ordered_scale"}], "scales": {"ECR7": [{"value": 1, "label_fr": "Fortement en désaccord"}, {"value": 2, "label_fr": "2"}, {"value": 3, "label_fr": "3"}, {"value": 4, "label_fr": "Ni en désaccord ni d’accord"}, {"value": 5, "label_fr": "5"}, {"value": 6, "label_fr": "6"}, {"value": 7, "label_fr": "Fortement d’accord"}]}, "shared": {"1": {"anxiete": 2.0, "evitement": 4.67}, "2": {"anxiete": 2.0, "evitement": 4.67}}, "declined": {}, "reserves": [], "completed": {"1": true, "2": true}, "page_size": 5}, "answers": [], "private": {"page": 1, "result": {"total": 9, "scores": {"anxiete": 2.0, "evitement": 4.67}, "status": "complete", "answered": 9}, "answers": {"ECRRS9-PARTNER-2011-FR03-01": 2, "ECRRS9-PARTNER-2011-FR03-02": 2, "ECRRS9-PARTNER-2011-FR03-03": 2, "ECRRS9-PARTNER-2011-FR03-04": 2, "ECRRS9-PARTNER-2011-FR03-05": 2, "ECRRS9-PARTNER-2011-FR03-06": 2, "ECRRS9-PARTNER-2011-FR03-07": 2, "ECRRS9-PARTNER-2011-FR03-08": 2, "ECRRS9-PARTNER-2011-FR03-09": 2}}, "revealed": true, "round_no": 1, "solution": null, "reveal_at": null}], "my_seat": 1, "players": [{"seat": 1, "is_me": true, "ready": true, "user_id": "11111111-1111-4111-8111-111111111111", "word_form": "n", "avatar_path": null, "keep_memory": false, "display_name": "Maya"}, {"seat": 2, "is_me": false, "ready": true, "user_id": "22222222-2222-4222-8222-222222222222", "word_form": "n", "avatar_path": null, "keep_memory": false, "display_name": "Alex"}], "session": {"id": "3502f93f-ca71-424d-8b5e-f116d5dbbf5c", "result": {"common": 0, "rounds": 1, "success": 0}, "status": "ended", "game_id": "ND-Q-021", "ended_at": "2026-10-24T08:45:40.716245+00:00", "settings": {}, "closed_at": null, "paused_by": null, "read_only": false, "created_at": "2026-10-24T08:45:40.716245+00:00", "started_at": "2026-10-24T08:45:40.716245+00:00", "game_version": 1, "total_rounds": 1,